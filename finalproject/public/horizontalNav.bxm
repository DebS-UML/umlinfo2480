<bx:set articleService = new finalProject.common.Articles() />
<bx:set allArticles = articleService.allArticles( active=1) />

<nav class="navbar navbar-expand-xl navbar-light bg-light">
    <a class="navbar-brand" href="#">
        <a href="../public"><img src="/images/rdb.png" alt="Read Dese Books Logo"/></a>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarSupportedContent">
        <ul class="navbar-nav me-auto">
            <li class="nav-item active">
                <a class="nav-link" href="/finalProject/public">Home <span class="visually-hidden">(current)</span></a>
            </li>
            <bx:output>
                <bx:loop array=#allArticles# index="article">
                    <li class="nav-item">
                        <a class="nav-link" href="#cgi.script_name#?articleId=#article.id#&tool=articles">#article.title#</a>
                    </li>
                </bx:loop>
            </bx:output>
            <li class="nav-item">
            </li>
            <li class="nav-item">
                <a class="nav-link" href="../management">Management</a>
            </li>
        </ul>
        <form class="d-flex ms-auto">
            <input class="form-control me-2" type="search" placeholder="Search" aria-label="Search">
            <button class="btn btn-outline-success" type="submit">Search</button>
        </form>
    </div>
</nav>