<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Read Dese Books</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link href="../includes/css/class.css" rel="stylesheet"/>
    <link href="../includes/css/mycss.css" rel="stylesheet"/>
</head>
<body>
<div id="wrapper" class="container">
    <bx:include template="header.bxm" />
    <div id="horizontalnav" class="row">
        <bx:include template="horizontalNav.bxm" />
    </div>
    <div id="maincontent" class="row">
        <section id="center" class="col-sm-9 order-last">
            <bx:include template="carousel.bxm" />
        </section>
        <section id="left" class="col-sm-3 order-first">
            <bx:include template="genrenav.bxm" />
        </section>
    </div>
    <footer id="footer" class="row" style="text-align: center">
        <bx:include template="footer.bxm" />
    </footer>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-w76AqPfDkMBDXo30jS1Sgez6pr3x5MlQ1ZAGC+nuZB+EYdgRZgiwxhTBTkF7CXvN"
        crossorigin="anonymous">
</script>
<style>

    .carousel-inner {
        height: 600px;
        background-color: rgb(160, 170, 190);

    }
    .carousel-caption {
        background-color: rgba(211, 211, 211, 0.8);
        padding: 10px 15px;
        border-radius: 5px; 
        color: #000;
        
        top: 50%;
        transform: translateY(-50%); 
        bottom: initial;
    }

</style>
</body>
</html>
