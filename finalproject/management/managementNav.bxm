<bx:output >
    <nav class="navbar navbar-expand-lg navbar-light bg-light">
        <a class="navbar-brand" href="#cgi.script_name#?tool=dashboard">
            <a href="../public"><img src="/images/rdb.png" alt="Read Dese Books Logo"/>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="##navbarSupportedContent"
                aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarSupportedContent">
            <ul class="navbar-nav me-auto">
                <li class="nav-item active">
                    <a class="nav-link" href="#cgi.script_name#?tool=dashboard">Home #currClass#<span class="visually-hidden">(current)</span></a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#cgi.script_name#?tool=manageArticles">Articles #currClass#</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#cgi.script_name#?tool=manageBooks">Books #currClass#</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#cgi.script_name#?tool=manageUsers">Users #currClass#</a>
                </li>
            </ul>
        </div>
    </nav>
</bx:output>