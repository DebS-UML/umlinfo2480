] />

<!--- dump the myArray Array --->
<bx:dump var="#myArray#" label="MyArray">

<!--- Loop through the myArray Array and display info about each book, 
    tally up the total price, and display the total price --->
<br />
Receipt:<br />
<bx:set totalPrice = 0 />
<bx:set numBooks = #myArray.size()# />
<bx:loop array="#myArray#" index="bookIndex" item="bookItem">
    <bx:output>Book #bookIndex#: #bookItem.basicInfo.title#</bx:output> by 
    <bx:output>#bookItem.authorInfo.authorFirstName# #bookItem.authorInfo.authorLastName#</bx:output>, 
    <bx:output>#NumberFormat(number=bookItem.basicInfo.price, mask="_$,0.00")#</bx:output>
    <bx:set totalPrice += bookItem.basicInfo.price />
    <br />
</bx:loop> 
<br />
<bx:output>The total price of #numBooks# books: #NumberFormat(number=totalPrice, mask="_$,0.00")#</bx:output>